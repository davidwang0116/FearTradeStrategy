const tactical = data.tactical;
const tacticalPairs = [...(tactical.entry_pairs || []),...(tactical.exit_pairs || [])];
el("tactical-trigger").innerHTML = options([...new Set(tacticalPairs.map(row => row.trigger))].map(name => [name,name]));
const tacticalEpisodes = tactical.episodes || [];
el("tactical-rule").innerHTML = options([...new Set(tacticalEpisodes.map(row => row.rule))].map(name => [name,name]));
const tacticalNotes = {
  "first order": "One tranche, bought in full by the baseline at the trigger. Differences are in profit after costs, as a share of the order, with T-bill interest on idle cash.",
  "reserve profit": "The same plans, measured by what the investor earns on the whole reserve, with T-bill interest on unspent cash. This rewards buying more, so read it beside timing value.",
  "hold length": "Both sides buy the whole order at the trigger. One sells after 63 sessions and earns T-bills to session 126. Timing value is measured against an average-date purchase held as long, so it takes out the extra quarter in stocks.",
  reserve: "Four tranches, with the whole reserve at the trigger as the baseline. Plans that buy more earn more when QQQ rises, so the measure is timing value: profit beyond buying on an average date and holding as long.",
  exit: "The whole order is bought at the trigger. The baseline holds to the deadline. X3 as drafted is listed only to show its conflict with the price ladder.",
  portfolio: "A 70% QQQ/SPY core and 30% T-bill reserve, without the trend guard or QLD. Only X1 was selected. The other exits are described, not chosen. Matched compares with a static account that holds the sleeve's average QQQ weight.",
};
function renderTactical() {
  const test = el("tactical-test").value, trigger = el("tactical-trigger").value, window = +el("tactical-window").value;
  el("tactical-note").textContent = tacticalNotes[test];
  el("tactical-trigger").parentElement.hidden = test === "portfolio";
  el("tactical-window").parentElement.hidden = test === "portfolio" || test === "hold length";
  if (test === "portfolio") return table("tactical-table", ["Period","Rule","Share per trigger","Sharpe","Minus static","Minus matched static","90% interval vs matched","CAGR","Max drawdown","Average equity","Average QQQ sleeve","Reserve at episode lows","Lots","Lots cut by cash"],
    (tactical.portfolio || []).map(row => [row.period,row.rule,pct(row.size),sharpe(row.sharpe),sharpe(row.sharpe_minus_static),sharpe(row.sharpe_minus_matched),
      row.sharpe_minus_matched_low == null ? "—" : sharpe(row.sharpe_minus_matched_low) + " to " + sharpe(row.sharpe_minus_matched_high),pct(row.cagr),pct(row.max_drawdown),pct(row.average_equity),pct(row.average_tactical),pct(row.reserve_at_episode_lows),num(row.lots),num(row.short_of_cash)]), "Run run_tactical.py first");
  const group = test === "exit" ? tactical.exit_pairs : test === "hold length" ? tactical.hold_length : tactical.entry_pairs;
  const reserve = test.startsWith("reserve"), metric = test === "reserve" ? "timing_value" : test === "reserve profit" ? "pnl" : null;
  const rows = (group || []).filter(row => row.trigger === trigger && (test === "hold length" || row.window === window)
    && row.group === (reserve ? "reserve" : test) && (!metric || row.metric === metric));
  const pairs = [...new Map(rows.map(row => [[row.baseline,row.rule,row.metric].join("|"),row])).values()];
  // A plan that places no extra order ties with its baseline, and a tie is not "better".
  const acted = row => row.n == null ? "—" : `${Math.round(row.win_share * row.n)} of ${row.n - row.ties}`;
  table("tactical-table", ["Rule","Baseline","Measure","Training difference","Training better","Better where it differed","Training without best","90% interval","Detectable","Passes","Later difference","Later better","Training profit (baseline)","Later profit (baseline)","Training mean worst mark",...(reserve ? ["Reserve spent (training, later)"] : []),"Episodes (training, later)"],
    pairs.map(({baseline,rule,metric: measure}) => {
      const one = period => rows.find(row => row.baseline === baseline && row.rule === rule && row.metric === measure && row.period === period) || {};
      const train = one("training"), after = one("later");
      return [rule,baseline,measure === "pnl" ? "Profit" : "Timing value",spread(train.difference),pct(train.win_share),acted(train),spread(train.without_best),
        train.low90 == null ? "—" : spread(train.low90) + " to " + spread(train.high90),spread(train.detectable),train.passes === true ? "Yes" : "No",
        spread(after.difference),pct(after.win_share),`${pct(train.mean_pnl)} (${pct(train.baseline_pnl)})`,`${pct(after.mean_pnl)} (${pct(after.baseline_pnl)})`,pct(train.worst_mark),
        ...(reserve ? [`${pct(train.deployed)}, ${pct(after.deployed)}`] : []),`${num(train.n)}, ${num(after.n)}`];
    }), "Run run_tactical.py first");
}
function renderTacticalEpisodes() {
  const rows = tacticalEpisodes.filter(row => row.rule === el("tactical-rule").value);
  table("tactical-episodes", ["Trigger","Period","VIX","Fills or sales","Profit","Worst mark","Timing value","First exit signal"],
    rows.map(row => [row.trigger_date,row.period,decimal(row.vix),row.actions || "—",pct(row.pnl),pct(row.worst_mark),pct(row.timing_value),date(row.first_signal)]), "Run run_tactical.py first");
}
for (const id of ["tactical-test","tactical-trigger","tactical-window"]) el(id).addEventListener("change",renderTactical);
el("tactical-rule").addEventListener("change",renderTacticalEpisodes);
el("tactical-download").addEventListener("click",() => saveRows("tactical_episodes.csv",tacticalEpisodes.filter(row => row.rule === el("tactical-rule").value)));

const firstRules = ["VIX >= 24","VIX >= 24 + easing 5d","VIX >= 24 + easing 10d","VIX >= 24 + easing 20d","504d rank >= 80%"];
table("episode-first-table", ["Signal","New episode needs","Training episodes","Training excess","Later episodes","Later excess","Better, training","Better, later","Training without best","Later without best","Training return","Later return"],
  firstRules.flatMap(rule => ["trigger_standalone","trigger_standalone_quiet"].flatMap(name => {
    const rows = (tactical[name] || []).filter(row => row.rule === rule);
    if (!rows.length) return [];
    const t = rows.find(row => row.period === "training") || {}, l = rows.find(row => row.period === "later") || {};
    return [[rule === "VIX >= 24 + easing 20d" ? rule + " (reference)" : rule,rows[0].reset,num(t.n),spread(t.difference),num(l.n),spread(l.difference),pct(t.win_share),pct(l.win_share),
      spread(t.without_best),spread(l.without_best),pct(t.mean_pnl),pct(l.mean_pnl)]];
  })), "Run run_triggers.py first");

const signalEpisodes = tactical.trigger_episodes || [];
el("signals-rule").innerHTML = options([...new Set(signalEpisodes.map(row => row.rule))].map(name => [name,name]));
const signalFamily = (tactical.trigger_family || [])[0];
if (signalFamily) el("signals-family").textContent = `${signalFamily.signals_tested} signals have enough training episodes. ${signalFamily.passes_observed} pass the rule. Luck alone gives about ${signalFamily.passes_by_luck_mean.toFixed(1)} on average (95th percentile ${signalFamily.passes_by_luck_95th.toFixed(0)}), and the chance of this many or more is ${pct(signalFamily.chance_of_this_many_passes)}. The chance that the best of ${signalFamily.signals_tested} signals looks at least this good is ${pct(signalFamily.chance_of_best)}.`;
function renderSignals() {
  const view = el("signals-view").value, sort = el("signals-sort").value;
  el("signals-definition").parentElement.hidden = view !== "standalone";
  // The luck check covers the standalone test with the episode definition that decides.
  el("signals-family").hidden = !signalFamily || view !== "standalone" || el("signals-definition").value !== "trigger_standalone";
  const index = rows => { const out = {}; rows.forEach(row => { (out[row.rule] ??= {})[row.period] = row; }); return out; };
  const key = row => sort === "train" ? row.training?.difference : row.later?.difference;
  const ordered = grouped => Object.entries(grouped).sort((a,b) => (key(b[1]) ?? -9) - (key(a[1]) ?? -9));
  if (view === "standalone") {
    const grouped = index(tactical[el("signals-definition").value] || []);
    return table("signals-table", ["Signal","New episode needs","Training episodes","Training excess","90% interval","Better","Without best","Single-signal luck p","Passes","Later episodes","Later excess","Later better","Later without best","Episodes / year (later)","Training return","Mean worst close"],
      ordered(grouped).map(([name,row]) => { const t = row.training || {}, l = row.later || {};
        return [name,t.reset || l.reset,num(t.n),spread(t.difference),t.low90 == null ? "—" : spread(t.low90) + " to " + spread(t.high90),pct(t.win_share),spread(t.without_best),
          t.shift_p == null ? "—" : t.shift_p.toFixed(3),t.passes ? "Yes" : "No",num(l.n),spread(l.difference),pct(l.win_share),spread(l.without_best),decimal(l.per_year),pct(t.mean_pnl),pct(t.worst_mark)]; }), "Run run_triggers.py first");
  }
  if (view === "paired") {
    const grouped = index(tactical.trigger_pairs || []);
    return table("signals-table", ["Signal","Training episodes","Fired","Median wait","Training difference","90% interval","Better","Without best","Passes","Later episodes","Later fired","Later difference","Later better"],
      ordered(grouped).map(([name,row]) => { const t = row.training || {}, l = row.later || {};
        return [name,num(t.n),num(t.fired),num(t.median_wait),spread(t.difference),t.low90 == null ? "—" : spread(t.low90) + " to " + spread(t.high90),pct(t.win_share),spread(t.without_best),t.passes ? "Yes" : "No",num(l.n),num(l.fired),spread(l.difference),pct(l.win_share)]; }), "Run run_triggers.py first");
  }
  if (view === "exits") {
    const rows = (tactical.trigger_exits || []).filter(row => row.period === "training"), exits = [...new Set(rows.map(row => row.exit))];
    return table("signals-table", ["Signal","Episodes",...exits], [...new Set(rows.map(row => row.rule))].map(name => {
      const own = rows.filter(row => row.rule === name); return [name,num(own[0].n),...exits.map(e => spread(own.find(row => row.exit === e)?.difference))]; }), "Run run_triggers.py first");
  }
  const rows = (tactical.trigger_portfolio || []).filter(row => row.size < .1), grouped = {};
  rows.forEach(row => { (grouped[row.rule] ??= {})[row.period] = row; });
  table("signals-table", ["Signal","Sharpe, training","Minus matched static","Max drawdown, training","Sharpe, later","Minus matched static, later","Max drawdown, later","Lots, training / later"],
    Object.entries(grouped).map(([name,row]) => { const t = row.training || {}, l = row.later || {};
      return [name,sharpe(t.sharpe),sharpe(t.sharpe_minus_matched),pct(t.max_drawdown),sharpe(l.sharpe),sharpe(l.sharpe_minus_matched),pct(l.max_drawdown),`${num(t.lots)} / ${num(l.lots)}`]; }), "Run run_triggers.py first");
}
function renderSignalEpisodes() {
  const rows = signalEpisodes.filter(row => row.rule === el("signals-rule").value);
  table("signals-episodes", ["Signal","Period","Entry","VIX","Return","Beyond an average date","Worst close"],
    rows.map(row => [row.signal_date,row.period,row.entry_date,decimal(row.vix),pct(row.pnl),spread(row.excess),pct(row.worst_mark)]), "Run run_triggers.py first");
}
for (const id of ["signals-view","signals-definition","signals-sort"]) el(id).addEventListener("change",renderSignals);
el("signals-rule").addEventListener("change",renderSignalEpisodes);

const ledgerRules = [...new Set(data.ledger.map(row => row.rule))];
el("ledger-rule").innerHTML = options(ledgerRules.map(name => [name,name]));
if (ledgerRules.includes(data.reference)) el("ledger-rule").value = data.reference;
el("ledger-period").innerHTML = el("portfolio-period").innerHTML;
el("ledger-period").value = "later";
function ledgerRows() {
  const kind = el("ledger-kind").value;
  // Some rules also ran on shorter samples. Show the longest run.
  const rows = data.ledger.filter(row => row.rule === el("ledger-rule").value && row.period === el("ledger-period").value);
  const first = rows.length ? rows.map(row => row.measured_from).sort()[0] : "";
  return rows.filter(row => row.measured_from === first && (kind === "all" || (kind === "tranche" ? /tranche/ : /qld/).test(row.action)));
}
function renderLedger() {
  const rows = ledgerRows();
  const bought = rows.filter(row => row.action === "tranche" && row.qqq_next_63 != null);
  el("ledger-summary").textContent = rows.length ? `${rows.length} trades · measured from ${rows[0].measured_from}` +
    (bought.length ? ` · ${bought.length} tranches with a complete outcome, next 63-session QQQ mean ${pct(mean(bought.map(row => row.qqq_next_63)))}` : "") : "No trades for this choice";
  table("ledger-table", ["Date","Side","Action","% of account","QQQ close","VIX at signal","Cash after","Exposure after","QQQ next 63 sessions"],
    rows.map(row => [row.date,row.side,row.action,pct(row.share_of_account),row.qqq_close.toFixed(2),decimal(row.vix_at_signal),pct(row.cash_after),pct(row.exposure_after),pct(row.qqq_next_63)]));
}
for (const id of ["ledger-rule","ledger-period","ledger-kind"]) el(id).addEventListener("change",renderLedger);
el("ledger-download").addEventListener("click",() => saveRows("vix_portfolio_trades.csv",ledgerRows()));

let joined = [], page = 0;
const PAGE_SIZE = 12;
function comparison() {
  const a = readRule("a"), b = readRule("b");
  const period = el("period").value, from = el("from").value, to = el("to").value;
  const sample = data.days.filter(row => later(row, period) && (!from || row.signal_date >= from) &&
    (!to || row.signal_date <= to) && (!el("exclude-2020").checked || !row.signal_date.startsWith("2020")));
  joined = sample.map(row => ({...row, a:matches(row,a), b:matches(row,b)}))
    .filter(row => row.a != null && row.b != null);
  el("quintile-note").hidden = a.mode !== "q5" && b.mode !== "q5";
  el("comparison-coverage").textContent = `${num(joined.length)} of ${num(sample.length)} dates have data for both rules · ${coverage(joined, "signal_date")}`;
  const selection = (label, rows, countEpisodes = true) => {
    const values = rows.map(row => row.qqq_return).sort((x,y) => x-y);
    const starts = rows.filter((row,i) => !i || row.session - rows[i-1].session > 21);
    const gaps = starts.slice(1).map((row,i) => row.session - starts[i].session).sort((x,y) => x-y);
    return [label, num(rows.length), pct(joined.length ? rows.length / joined.length : null), pct(mean(values)), spread(delta(mean(values),avgReturn(joined))),
      pct(quantile(values,.10)), pct(mean(rows.map(row => row.max_drawdown))),
      countEpisodes ? num(starts.length) : "—", countEpisodes ? num(quantile(gaps,.50)) : "—",
      countEpisodes && gaps.length ? num(gaps[0]) + "–" + num(gaps.at(-1)) : "—",
      countEpisodes ? pct(mean(gaps.map(gap => +(gap >= 90)))) : "—",
      countEpisodes ? spread(delta(avgReturn(starts),avgReturn(joined))) : "—"];
  };
  table("comparison", ["Selection","Signal days","% of days","Mean return","Spread","10th pct.","Mean max DD","Episodes","Median gap (sessions)","Gap range","Gaps ≥ 90","First-entry spread"], [
    selection("A · "+nameOf(a), joined.filter(row => row.a)),
    selection("B · "+nameOf(b), joined.filter(row => row.b)),
    selection("Both", joined.filter(row => row.a && row.b)),
    selection("A only", joined.filter(row => row.a && !row.b)),
    selection("B only", joined.filter(row => row.b && !row.a)),
    selection("All shared dates", joined, false)
  ]);
  page = 0;
  dates();
  plot();
}

function selectedDates() {
  const overlap = el("overlap").value;
  return joined.filter(r => overlap === "a" ? r.a && !r.b : overlap === "b" ? r.b && !r.a :
    overlap === "both" ? r.a && r.b : r.a || r.b);
}
const matchName = row => row.a && row.b ? "Both" : row.a ? "A only" : "B only";
function dates() {
  const selected = selectedDates(), offset = page * PAGE_SIZE;
  table("dates", ["Signal date","Matched","VIX close","VIX high","QQQ entry","QQQ exit","Return","Max DD"],
    selected.slice(offset,offset+PAGE_SIZE).map(row => [row.signal_date,matchName(row),row.close.toFixed(2),
      row.high == null ? "—" : row.high.toFixed(2),row.entry_date,row.exit_date,pct(row.qqq_return),pct(row.max_drawdown)]));
  el("date-count").textContent = selected.length ? `${offset+1}–${Math.min(selected.length,offset+PAGE_SIZE)} of ${num(selected.length)}` : "No matching dates";
  el("prev").disabled = page === 0;
  el("next").disabled = offset+PAGE_SIZE >= selected.length;
  el("download").disabled = selected.length === 0;
}
function plot() {
  const canvas = el("timeline"), scale = window.devicePixelRatio || 1;
  const width = canvas.clientWidth, height = canvas.clientHeight;
  canvas.width = width * scale; canvas.height = height * scale;
  const ctx = canvas.getContext("2d");
  ctx.scale(scale, scale);
  if (!joined.length) return;
  const first = joined[0].session, span = Math.max(1,joined.at(-1).session-first);
  const lanes = {"A only":17,"Both":41,"B only":65};
  const colors = {"A only":"#18563e","Both":"#73417e","B only":"#2b5d8f"};
  ctx.font = "12px system-ui";
  for (const [label,y] of Object.entries(lanes)) {
    ctx.fillStyle="#edf2ee"; ctx.fillRect(52,y-10,width-52,15);
    ctx.fillStyle=colors[label]; ctx.fillText(label,0,y);
  }
  for (const row of selectedDates()) {
    const name = matchName(row);
    ctx.fillStyle=colors[name];
    ctx.fillRect(52 + (width-54)*(row.session-first)/span,lanes[name]-10,2,15);
  }
}

function grid() {
  const period = el("grid-period").value, window = +el("grid-window").value;
  const floor = +el("grid-floor").value, metric = el("grid-metric").value;
  const matrix = new Map(data.grid.filter(row => row.period === period && row.window === window && row.floor === floor)
    .map(row => [row.rank+"/"+row.easing,row]));
  const label = value => metric === "days" ? num(value) : metric === "spread" ? spread(value) : pct(value);
  const rule = readRule("b");
  table("matrix", ["Rank",...data.lags.map(lag => lag ? lag+"d easing" : "No easing")],
    data.ranks.map(rank => [rank ? "≥ "+rank+"%" : "Off", ...data.lags.map(lag => {
      const row = matrix.get(rank+"/"+lag);
      const selected = rule.floor === floor && rule.window === window && rule.rank === rank && rule.easing === lag &&
        rule.mode === "rule" && rule.confirmation === "off" && rule.level === "close";
      const tone = row.spread == null ? "#fafbf9" : row.spread >= 0
        ? `hsl(145 36% ${98 - Math.min(22,row.spread*135)}%)` : `hsl(18 52% ${98 - Math.min(18,-row.spread*135)}%)`;
      return `<button data-rank="${rank}" data-lag="${lag}" aria-pressed="${selected}" class="${row.days<100?"few":""}" style="background:${tone}">` +
        `${label(row[metric])}<small>${num(row.days)} days</small></button>`;
    })]));
}
table("picks", ["Training selection","Selected rule","Training return","Later return","Later spread","Later days"],
  [["Original 504-session grid",zip],["All rank windows",data.extended_pick]].filter(([,pick])=>pick)
    .map(([label,pick])=>[label,nameOf({...defaultRule,...pick.training}),pct(pick.training.mean),pct(pick.later.mean),
      spread(pick.later.spread),num(pick.later.days)]));

function episodes() {
  const rows = data.episodes.filter(row => later(row,el("episode-period").value) && row.breakout === +el("episode-width").value);
  const paired = rows.filter(row => row.confirmation);
  el("episode-summary").textContent = `${paired.length} of ${rows.length} episodes confirmed · paired immediate ${pct(mean(paired.map(r=>r.immediate_return)))} · paired delayed ${pct(mean(paired.map(r=>r.delayed_return)))} · delayed with same exit ${pct(mean(paired.map(r=>r.same_exit_return)))}`;
  table("episode-table", ["Fear signal","Confirmation","Wait (sessions)","Immediate","Delayed","Delayed, same exit"],
    rows.map(r=>[r.trigger,date(r.confirmation),num(r.delay),pct(r.immediate_return),pct(r.delayed_return),pct(r.same_exit_return)]));
}
function portfolio() {
  const choice = el("portfolio-experiment");
  const title = choice.selectedOptions[0].textContent;
  const rows = data.portfolio.filter(row => row.experiment === title && row.period === el("portfolio-period").value);
  el("portfolio-coverage").textContent = rows.length ? coverage(rows,"first","last") + (rows[0].started !== rows[0].first ? ` · portfolio started ${rows[0].started}` : "") : "No funded run for this experiment and sample.";
  table("portfolio-table", ["Core tranche rule","Funded tranches","CAGR","Sharpe","Max drawdown","Volatility","Sortino","Calmar","Longest underwater (sessions)","Worst month","Positive months","Average exposure","Average cash","QLD buys","Greed trims"],
    rows.map(row=>[row.rule,num(row.tranches),pct(row.cagr),sharpe(row.sharpe),pct(row.drawdown),pct(row.volatility),sharpe(row.sortino),sharpe(row.calmar),num(row.longest_underwater),pct(row.worst_month),pct(row.positive_months),pct(row.average_exposure),pct(row.average_cash),num(row.qld_buys),num(row.greed_trims)]));
}

function preset(index) {
  const choice = data.presets[index];
  setRule("a",choice.a);
  setRule("b",choice.b);
  el("experiment").value = index;
  el("portfolio-experiment").value = index;
  comparison(); grid(); portfolio();
}
el("experiment").addEventListener("change", () => {if (el("experiment").value !== "custom") preset(+el("experiment").value);});
el("rules").addEventListener("change", () => {el("experiment").value="custom"; comparison(); grid();});
for (const id of ["period","from","to","exclude-2020"]) el(id).addEventListener("change",comparison);
for (const id of ["grid-period","grid-window","grid-floor","grid-metric"]) el(id).addEventListener("change",grid);
el("matrix").addEventListener("click", event => {
  const button = event.target.closest("[data-rank]");
  if (!button) return;
  setRule("b",{rank:+button.dataset.rank, easing:+button.dataset.lag, window:+el("grid-window").value, floor:+el("grid-floor").value});
  el("experiment").value = "custom";
  el("period").value = el("grid-period").value;
  comparison(); grid();
  el("matrix").querySelector(`[data-rank="${button.dataset.rank}"][data-lag="${button.dataset.lag}"]`).focus();
});
for (const id of ["episode-period","episode-width"]) el(id).addEventListener("change",episodes);
for (const id of ["portfolio-experiment","portfolio-period"]) el(id).addEventListener("change",portfolio);
el("prev").addEventListener("click",()=>{page--; dates();});
el("next").addEventListener("click",()=>{page++; dates();});
el("overlap").addEventListener("change",()=>{page=0; dates(); plot();});
function downloadCsv(file, rows) {
  const cell = value => value == null ? "" : '"' + String(value).replaceAll('"','""') + '"';
  const csv = rows.map(row => row.map(cell).join(",")).join("\n");
  const url = URL.createObjectURL(new Blob([csv],{type:"text/csv"}));
  const link = document.createElement("a"); link.href=url; link.download=file; link.click();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}
el("download").addEventListener("click",() => {
  const keys = ["signal_date","entry_date","exit_date","close","high","rank_252","rank_504","rank_1260","qqq_return","max_drawdown","match"];
  downloadCsv("vix_compared_signal_dates.csv", [keys,...selectedDates().map(row=>keys.map(key=>key === "match" ? matchName(row) : row[key]))]);
});
window.addEventListener("resize",plot);
renderTactical(); renderTacticalEpisodes(); renderSignals(); renderSignalEpisodes(); renderFrequency(); renderEntries(); renderLedger();
preset(data.presets.findIndex(row=>row.name==="QQQ recovery"));
episodes();
</script>
</body>
</html>
